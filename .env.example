# ============================================================
# KANBAN PROJECT — Root Environment Variables Template
# Copy this to .env at project root to override default ports or keys.
# ============================================================

# --- Application Environment ---
APP_ENV=development

# --- Host Port Overrides (Change here if local ports conflict) ---
PORT_NGINX=1106
PORT_WEB=3000
PORT_API=4000
PORT_AI=5000
PORT_POSTGRES=5432
PORT_REDIS=6379
PORT_MINIO=9000
PORT_MINIO_CONSOLE=9001

# --- PostgreSQL Database ---
POSTGRES_USER=kanban
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kanban

# --- Redis Cache ---
REDIS_PASSWORD=

# --- MinIO Object Storage ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Go API Authentication & Security ---
JWT_SECRET=changeme-use-a-long-random-secret-min-32-chars
API_CORS_ORIGINS=http://localhost:1106,http://localhost:3000,http://localhost:4000

# --- OpenAI (Optional for AI service) ---
# OPENAI_API_KEY=sk-your-openai-key-here

# --- Anthropic (Optional for AI service) ---
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
