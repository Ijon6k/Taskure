# ============================================================
# KANBAN PROJECT — Master Environment Variables Template
# Copy this file to .env at project root: cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------
# Options: development, production, test
APP_ENV=development

# ------------------------------------------------------------
# 2. HOST PORT OVERRIDES (Self-Hosted / Local Docker Compose)
# ------------------------------------------------------------
# Change these ports if they conflict with existing local services.
PORT_NGINX=1106
PORT_WEB=3000
PORT_API=4000
PORT_AI=5000
PORT_POSTGRES=5432
PORT_REDIS=6379
PORT_MINIO=9000
PORT_MINIO_CONSOLE=9001

# ------------------------------------------------------------
# 3. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kanban
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kanban

# ------------------------------------------------------------
# 4. REDIS CACHE & EVENT BUS (OPTIONAL)
# ------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------
# 5. MINIO / S3 OBJECT STORAGE CONFIGURATION (Task Attachments)
# ------------------------------------------------------------
# S3 / MinIO endpoint hostname:port (Inside Docker: minio:9000, Outside Docker: localhost:9000)
MINIO_ENDPOINT=minio:9000

# Access Key / Username (Supports MINIO_ACCESS_KEY, MINIO_ROOT_USER, MINIO_USER, or AWS_ACCESS_KEY_ID)
MINIO_ROOT_USER=minioadmin
MINIO_ACCESS_KEY=minioadmin

# Secret Key / Password (Supports MINIO_SECRET_KEY, MINIO_ROOT_PASSWORD, MINIO_PASSWORD, or AWS_SECRET_ACCESS_KEY)
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO S3 Bucket Name for task file attachments
MINIO_BUCKET=kanban-uploads

# Public URL base accessed by browser clients to render/download files via Nginx proxy
MINIO_PUBLIC_URL=http://localhost:1106/storage/kanban-uploads

# Set to true if MinIO / S3 endpoint uses HTTPS
MINIO_USE_SSL=false

# ------------------------------------------------------------
# 6. GO REST API SECURITY & CORS
# ------------------------------------------------------------
# Secret key used for signing JWT tokens (min 32 characters for production)
JWT_SECRET=changeme-use-a-long-random-secret-min-32-chars

# Allowed Origins for CORS (comma-separated URLs)
API_CORS_ORIGINS=http://localhost:1106,http://localhost:3000,http://localhost:4000

# ------------------------------------------------------------
# 7. AI ASSISTANT API KEYS (OPTIONAL)
# ------------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
