# ============================================================
# TASKURE — Master Environment Variables Template
# Copy this file to .env at project root: cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# 0. GHCR CONTAINER IMAGE TAG (Self-Hosted Deployment)
# ------------------------------------------------------------
# Choose which image tag to pull from GitHub Container Registry (GHCR):
#   - latest  : Latest stable release from main branch
#   - dev     : Latest development build from dev branch
#   - sha-<id>: Specific commit SHA (e.g. sha-63693a7)
IMAGE_TAG=latest

# ------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------
# Options: development, production, test
APP_ENV=production

# ------------------------------------------------------------
# 2. HOST PORT OVERRIDES (External Access Port)
# ------------------------------------------------------------
# Port 1106 is the default external port for the Caddy gateway.
# In production compose, ONLY this gateway port is exposed to the host.
PORT_GATEWAY=1106
PORT_NGINX=1106

# Dev-only direct ports (only exposed when running compose.dev.yaml):
PORT_WEB=3000
PORT_API=4000
PORT_AI=5000
PORT_POSTGRES=5432
PORT_MINIO=9000
PORT_MINIO_CONSOLE=9001

# ------------------------------------------------------------
# 3. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kanban
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kanban

# ------------------------------------------------------------
# 4. MINIO / S3 OBJECT STORAGE CONFIGURATION (Task Attachments)
# ------------------------------------------------------------
# S3 / MinIO endpoint hostname:port (Inside Docker/Podman: minio:9000, Outside: localhost:9000)
MINIO_ENDPOINT=minio:9000

# Access Key / Username
MINIO_ROOT_USER=minioadmin
MINIO_ACCESS_KEY=minioadmin

# Secret Key / Password
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO S3 Bucket Name for task file attachments
MINIO_BUCKET=kanban-uploads

# Public URL base accessed by browser clients to render/download files via Gateway
MINIO_PUBLIC_URL=/storage/kanban-uploads

# Set to true if MinIO / S3 endpoint uses HTTPS
MINIO_USE_SSL=false

# ------------------------------------------------------------
# 5. GO REST API SECURITY & CORS
# ------------------------------------------------------------
# Secret key used for signing JWT tokens (min 32 characters for production)
JWT_SECRET=changeme-use-a-long-random-secret-min-32-chars

# 32-byte encryption key for sensitive values
ENCRYPTION_KEY=dev-encryption-key-32-bytes!!

# ------------------------------------------------------------
# 6. AI SERVICE & LLM PROVIDERS (Optional)
# ------------------------------------------------------------
# Set your API keys if you plan to use AI features
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_MODEL=claude-sonnet-4-20250514
