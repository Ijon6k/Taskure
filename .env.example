# ============================================================
# TASKURE — Master Environment Variables Template
# Copy this file to .env at project root: cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# 0. GHCR CONTAINER IMAGE TAG (Self-Hosted Deployment)
# ------------------------------------------------------------
# Choose which image tag to pull from GitHub Container Registry (GHCR):
#   - latest  : Latest stable release from main branch
#   - dev     : Latest development build from dev branch
#   - sha-<id>: Specific commit SHA (e.g. sha-63693a7)
IMAGE_TAG=latest

# ------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------
# Options: development, production, test
APP_ENV=production

# ------------------------------------------------------------
# 2. HOST PORT OVERRIDES (External Access Port)
# ------------------------------------------------------------
# Port 1106 is the default external port for the gateway.
# In production compose, ONLY this gateway port is exposed to the host.
PORT_NGINX=1106

# Dev-only direct ports:
PORT_WEB=3000
PORT_API=4000
PORT_AI=5000
PORT_POSTGRES=5432
PORT_S3=9000
PORT_S3_FILER=8888

# ------------------------------------------------------------
# 3. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kanban
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kanban

# ------------------------------------------------------------
# 4. SEAWEEDFS / S3 OBJECT STORAGE CONFIGURATION (Task Attachments)
# ------------------------------------------------------------
# S3 endpoint hostname:port (Inside Docker: seaweedfs:9000, Outside Docker: localhost:9000)
S3_ENDPOINT=seaweedfs:9000

# Access Key / Username (Matches seaweedfs/s3.json credentials)
S3_ACCESS_KEY=seaweedadmin

# Secret Key / Password (Matches seaweedfs/s3.json credentials)
S3_SECRET_KEY=seaweedadmin

# S3 Bucket Name for task file attachments
S3_BUCKET=kanban-uploads

# Public URL base accessed by browser clients to render/download files via Nginx proxy
S3_PUBLIC_URL=/storage/kanban-uploads

# Set to true if S3 endpoint uses HTTPS
S3_USE_SSL=false

# ------------------------------------------------------------
# 5. GO REST API SECURITY & CORS
# ------------------------------------------------------------
# Secret key used for signing JWT tokens (min 32 characters for production)
JWT_SECRET=changeme-use-a-long-random-secret-min-32-chars

# 32-byte encryption key for sensitive values
ENCRYPTION_KEY=dev-encryption-key-32-bytes!!

# ------------------------------------------------------------
# 6. AI SERVICE & LLM PROVIDERS (Optional)
# ------------------------------------------------------------
# Set your API keys if you plan to use AI features
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_MODEL=claude-sonnet-4-20250514
