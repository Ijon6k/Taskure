# ============================================================
# KANBAN BACKEND — Go API Environment Variables Template
# Copy this to .env in backend/ directory if running Go natively.
# ============================================================

APP_ENV=development

# Server Binding
API_HOST=0.0.0.0
API_PORT=4000

# CORS Allowed Origins
API_CORS_ORIGINS=http://localhost:1106,http://localhost:3000,http://localhost:4000

# PostgreSQL Connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kanban
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kanban

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT
JWT_SECRET=changeme-use-a-long-random-secret-min-32-chars
JWT_EXPIRY_HOURS=72

# MinIO Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=kanban-uploads
