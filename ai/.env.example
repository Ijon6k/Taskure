# ============================================================
# KANBAN AI SERVICE — Environment Variables Template
# ============================================================

AI_HOST=0.0.0.0
AI_PORT=5000

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kanban
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kanban

# LLM Providers
# OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# BYOK Encryption (32-byte hex)
# ENCRYPTION_KEY=

# Mode Config
FAST_MAX_TOKENS=500
THINKING_MAX_TOKENS=4000
PLANNING_MAX_TOKENS=8000
AGENT_MAX_TOKENS=16000

# RAG
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=128
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# Reflection
REFLECTION_QUALITY_THRESHOLD=80
REFLECTION_TIMEOUT_SECONDS=120

# HITL Approval
HITL_APPROVAL_TIMEOUT_SECONDS=300

# Workers
AI_WORKER_POLL_INTERVAL=5
AI_MEMORY_EVOLUTION_THRESHOLD=15
AI_PLAN_CACHE_TTL_HOURS=24
