# ============================================================
# KANBAN FRONTEND — Environment Variables Template
# Copy this to .env.local for local Next.js development.
# ============================================================

# API Base URL (Use relative /api for seamless Same-Origin proxying)
NEXT_PUBLIC_API_URL=/api

# Target Go Backend API Port for Next.js Rewrites Proxy
PORT_API=4000

# Local Next.js Server Port
PORT=3000
