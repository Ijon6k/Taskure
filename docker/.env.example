# ============================================================
# KANBAN PROJECT — Environment Variables Template
# Copy this file to .env in the docker/ directory and fill in values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development

# --- PostgreSQL (shared by api and ai) ---
POSTGRES_USER=kanban
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kanban
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=kanban-uploads
MINIO_REGION=us-east-1

# --- API (Go backend) ---
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- AI Service (Python/FastAPI) ---
AI_PORT=5000
AI_HOST=0.0.0.0

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_EMBEDDING_MODEL=claude-embedding-3

# --- JWT ---
JWT_SECRET=changeme-use-a-long-random-secret-min-32-chars
JWT_EXPIRY_HOURS=72

# --- Nginx ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
